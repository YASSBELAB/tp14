{
  "id": null,
  "uid": "laravel-backend-overview",
  "title": "Laravel Backend Overview",
  "tags": ["laravel", "php", "prometheus"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Total HTTP requests",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 8, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" }, "colorMode": "value", "graphMode": "area", "orientation": "auto", "textMode": "auto" },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "prometheus" }, "editorMode": "code", "expr": "sum(laravel_http_requests_total)", "instant": true, "range": false, "refId": "A" }]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Average Eloquent query duration",
      "description": "Mean execution time of database queries emitted by Laravel's database layer, including Eloquent queries.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 5 },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 12, "showPoints": "never" } }, "overrides": [] },
      "options": { "tooltip": { "mode": "multi", "sort": "desc" }, "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "prometheus" }, "editorMode": "code", "expr": "sum by (connection) (rate(laravel_database_query_duration_seconds_sum[5m])) / sum by (connection) (rate(laravel_database_query_duration_seconds_count[5m]))", "legendFormat": "{{connection}}", "refId": "A" }]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Average HTTP request duration",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 15 },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" } }, "overrides": [] },
      "options": { "tooltip": { "mode": "multi", "sort": "desc" }, "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "prometheus" }, "editorMode": "code", "expr": "sum by (route) (rate(laravel_http_request_duration_seconds_sum[5m])) / sum by (route) (rate(laravel_http_request_duration_seconds_count[5m]))", "legendFormat": "{{route}}", "refId": "A" }]
    }
  ]
}
